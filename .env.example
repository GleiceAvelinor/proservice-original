# ============================================================
# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env
# ============================================================

# Django
SECRET_KEY=sua-chave-secreta-muito-segura-aqui-troque-agora
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# PostgreSQL
DB_NAME=saas_db
DB_USER=postgres
DB_PASSWORD=sua_senha_postgres
DB_HOST=localhost
DB_PORT=5432

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.development

# Email (opcional para desenvolvimento)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app

# Domínio base do SaaS (subdomínios serão gerados a partir daqui)
# Ex: ji.saas.localhost, levi.saas.localhost
BASE_DOMAIN=localhost
